{
  "name": "My Setup",
  "id": "my-setup",
  "version": "6.0.0",
  "description": "自分の共通開発環境（VS Code拡張・設定・zsh・git/gh連携・Claude Code・OpenCode・Python）",
  "options": {
    "gitUserName": {
      "type": "string",
      "default": "",
      "description": "git config --global user.name に設定する値（空の場合は設定しない）"
    },
    "gitUserEmail": {
      "type": "string",
      "default": "",
      "description": "git config --global user.email に設定する値（空の場合は設定しない）"
    },
    "starship": {
      "type": "boolean",
      "default": true,
      "description": "starship プロンプトをインストールして ~/.zshrc で初期化する"
    },
    "autosuggestions": {
      "type": "boolean",
      "default": true,
      "description": "zsh-autosuggestions をインストールして ~/.zshrc で読み込む"
    },
    "persistHistory": {
      "type": "boolean",
      "default": true,
      "description": "zsh のコマンド履歴をワークスペース内（.devcontainer/.my-setup）に保存し、コンテナを作り直しても引き継ぐ"
    },
    "syntaxHighlighting": {
      "type": "boolean",
      "default": true,
      "description": "zsh-syntax-highlighting をインストールして ~/.zshrc で読み込む"
    }
  },
  "dependsOn": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/node:2.1.2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/dirien/devcontainer-features/opencode:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-containers",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "eamodio.gitlens",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "python-envs.defaultEnvManager": "ms-python.python:system",
        "python.analysis.typeCheckingMode": "standard",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/mnt/my-setup/data/claude"
  },
  "onCreateCommand": "/usr/local/share/my-setup/init-data.sh",
  "postCreateCommand": "opencode upgrade 2.3.2 --major"
}
