{
  "name": "OpenCode",
  "id": "opencode",
  "version": "1.0.1",
  "description": "[非推奨: my-setup に統合] OpenCode と設定・データの永続化",
  "documentationURL": "https://opencode.ai",
  "dependsOn": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/dirien/devcontainer-features/opencode:0": {}
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.config/opencode",
      "target": "/mnt/opencode/config"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.local/share/opencode",
      "target": "/mnt/opencode/data"
    },
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.local/state/opencode",
      "target": "/mnt/opencode/state"
    }
  ],
  "postCreateCommand": "opencode upgrade 2.3.2 --major",
  "deprecated": true
}
