{
  "name": "Claude Code",
  "id": "claude",
  "version": "2.0.0",
  "description": "Claude Code と設定・認証情報の永続化",
  "documentationURL": "https://docs.claude.com/en/docs/claude-code",
  "dependsOn": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/node"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/mnt/claude/config"
  },
  "mounts": [
    {
      "type": "bind",
      "source": "${localEnv:HOME}/.claude",
      "target": "/mnt/claude/config"
    }
  ]
}
