{
  "name": "Python",
  "id": "python",
  "version": "1.0.1",
  "description": "[非推奨: my-setup に統合] Python向けのVS Code拡張と設定",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system",
        "python.analysis.typeCheckingMode": "standard",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "deprecated": true
}
